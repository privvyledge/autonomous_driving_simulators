# .env.example — copy to .env and edit for your environment.
# docker compose reads .env automatically.

# ── ROS2 ────────────────────────────────────────────────────────────────────
# Isolate this stack from other ROS2 processes on the same host.
ROS_DOMAIN_ID=0

# ── CARLA ───────────────────────────────────────────────────────────────────
CARLA_VERSION=0.9.15
CARLA_HOST=localhost
CARLA_PORT=2000
CARLA_TOWN=Town01
CARLA_FPS=20
# Low | Medium | High | Epic
CARLA_QUALITY=Low

# ── AWSIM ───────────────────────────────────────────────────────────────────
AWSIM_VERSION=1.1.1

# ── Autoware ────────────────────────────────────────────────────────────────
VEHICLE_ID=default

# ── Paths (resolved inside the container unless you override mounts) ─────────
# Directory containing the compiled MPC model. Mounted into the autoware container.
MPC_MODEL_PATH=/home/carla/sdks/mpc/carla
# Path to the waypoints CSV file as seen from inside the container.
# Default maps to ./data/waypoints/waypoints.csv via the ./data/waypoints:/waypoints mount.
WAYPOINTS_CSV=/waypoints/waypoints.csv

# ── Traffic Generator ────────────────────────────────────────────────────────
NUM_VEHICLES=30
NUM_WALKERS=10
