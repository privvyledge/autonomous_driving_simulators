# .env.example — copy to .env and edit for your environment.
# docker compose reads .env automatically.

# ── ROS2 ────────────────────────────────────────────────────────────────────
# Isolate this stack from other ROS2 processes on the same host.
ROS_DOMAIN_ID=0

# ── CARLA ───────────────────────────────────────────────────────────────────
CARLA_VERSION=0.9.14
CARLA_HOST=localhost
CARLA_PORT=2000
CARLA_TOWN=Town01
CARLA_FPS=20
# Low | Medium | High | Epic
CARLA_QUALITY=Low
# true  = headless (xvfb + -RenderOffScreen, no window, works without a display)
# false = windowed (requires: xhost +local:docker run on the host first)
CARLA_HEADLESS=true
# true  = remap raw CARLA sensor topics to Autoware sensing topics (camera/lidar/gnss/imu)
# false = publish the raw /carla/<role_name>/* topics unchanged
REMAP_TO_AUTOWARE=false

# ── Scene (ego + obstacles) ──────────────────────────────────────────────────
# carla_spawn_objects definition file, read INSIDE the container (./config is
# bind-mounted to /config:ro). objects.json = ego vehicle only (clean runs, e.g.
# recording waypoints); obstacles.json = ego + static obstacle vehicles/pedestrian.
OBJECTS_DEFINITION_FILE=/config/obstacles.json

# ── Autonomy / control toggles ───────────────────────────────────────────────
# CARLA's global route planner (carla_waypoint_publisher): publishes a lane-level
# route to /carla/<role>/waypoints from a goal pose. Set False to use your own planner.
START_GLOBAL_PLANNER_CARLA=True
# CARLA's built-in AD agent (carla_ad_agent + local_planner) that drives to the goal.
# Set False when running your own controller so they don't both publish vehicle_control_cmd.
LAUNCH_BUILTIN_AGENT=True
# Run CARLA low-level actuation (carla_ackermann_control / carla_twist_to_control) in the
# bridge container. Enable for the custom-controller path; pair with LAUNCH_BUILTIN_AGENT=False.
LAUNCH_ACTUATION=False
# False = carla_ackermann_control (AckermannDriveStamped input, published to /drive).
# True  = carla_twist_to_control (Twist input).
PUBLISH_TWIST=False

# ── AWSIM ───────────────────────────────────────────────────────────────────
AWSIM_VERSION=1.1.1

# ── Autoware ────────────────────────────────────────────────────────────────
VEHICLE_ID=default

# ── Paths (resolved inside the container unless you override mounts) ─────────
# Directory containing the compiled MPC model. Lives under the host ./data bind mount.
MPC_MODEL_PATH=/home/carla/data/mpc/carla
# Path to the waypoints CSV file as seen from inside the container.
# Maps to host ./data/waypoints/waypoints.csv via the ./data:/home/carla/data mount
# (same ./data bind mount as MPC_MODEL_PATH).
WAYPOINTS_CSV=/home/carla/data/waypoints/waypoints.csv

# ── Traffic Generator ────────────────────────────────────────────────────────
NUM_VEHICLES=30
NUM_WALKERS=10
